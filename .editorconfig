# EditorConfig for GraftX — https://editorconfig.org
# Defines consistent coding styles across editors and IDEs.
root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust source files
[*.rs]
indent_size = 4

# Structured config and documentation formats
[*.{yml,yaml,toml,json,md}]
indent_size = 2

# Markdown: trailing whitespace is significant (two spaces == hard line break)
[*.md]
trim_trailing_whitespace = false
